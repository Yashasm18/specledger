[MAIN]
py-version = 3.11
jobs = 0
init-hook='import sys; sys.path.extend(["backend", "."])'

[MESSAGES CONTROL]
disable =
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    line-too-long,
    trailing-whitespace,
    trailing-newlines,
    too-many-instance-attributes,
    too-few-public-methods,
    too-many-return-statements,
    too-many-branches,
    too-many-arguments,
    too-many-locals,
    too-many-statements,
    too-many-positional-arguments,
    unused-argument,
    unused-variable,
    broad-exception-caught,
    fixme,
    import-outside-toplevel

[FORMAT]
max-line-length = 140

[DESIGN]
max-args = 10
max-locals = 40
max-returns = 12
max-branches = 20
max-statements = 80
max-attributes = 60
