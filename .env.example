DATABASE_URL=postgresql://specledger:specledger_dev_only@localhost:5432/specledger
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5174,https://specledger-app.vercel.app
VITE_API_URL=http://localhost:8000

# Optional: gates POST/PATCH endpoints behind an X-API-Key header. Unset = no
# auth (fine for local dev). Set the same value here and as VITE_API_KEY so
# the frontend can call protected endpoints.
SPECLEDGER_API_KEY=
VITE_API_KEY=

# Optional: durable object storage for uploaded PDFs/artifacts via Supabase
# Storage. Unset = local disk (fine for dev, not durable on hosts that wipe
# local disk between deploys).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=specledger-artifacts

# Optional: real web search (https://serper.dev) used by live_fetch to
# identify a product's actual manufacturer when the raw input's manufacturer
# field is a distributor, not the manufacturer. Unset = that fallback is
# skipped; direct-domain guessing still runs.
SERPER_API_KEY=
